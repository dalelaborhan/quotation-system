\
def quotation(age, gender, with_booster, job_class):\
    if gender == 'Male':\
        base = base_annual_male.get(age)\
        booster = booster_male.get(age, 0)\
    else:\
        base = base_annual_female.get(age)\
        booster = booster_female.get(age, 0)\
    \
    if base is None:\
        return None\
    \
    total = base + (booster if with_booster else 0)\
    \
    if job_class == 4:\
        total = total * 1.40\
    \
    return \{\
        'monthly': round(total / 12, 2),\
        'annual': round(total, 2)\
    \}\
\
# Interface\
st.set_page_config(page_title="AIA MediFlex-i", page_icon="\uc0\u55357 \u56496 ")\
st.title("\uc0\u55357 \u56496  AIA MediFlex-i Quotation System")\
st.markdown("### A-Life MediFlex-i (Plan 250 | RM500 Deductible)")\
\
col1, col2 = st.columns(2)\
\
with col1:\
    age = st.number_input("\uc0\u55357 \u56517  Umur (tahun)", min_value=20, max_value=55, value=35, step=1)\
    gender = st.radio("\uc0\u55357 \u56420  Jantina", ["Male", "Female"])\
\
with col2:\
    coverage = st.radio("\uc0\u55357 \u56458  Coverage", ["RM250,000 (Tanpa Booster)", "RM1,000,000 (Dengan Booster)"])\
    job_class = st.selectbox("\uc0\u55356 \u57314  Kelas Pekerjaan", [1, 2, 3, 4])\
\
if st.button("\uc0\u55357 \u56589  Dapatkan Quotation", type="primary"):\
    with_booster = coverage == "RM1,000,000 (Dengan Booster)"\
    result = quotation(age, gender, with_booster, job_class)\
    \
    if result:\
        st.success("\uc0\u9989  QUOTATION BERJAYA!")\
        col_a, col_b = st.columns(2)\
        with col_a:\
            st.metric("\uc0\u55357 \u56496  Caruman Bulanan", f"RM \{result['monthly']:,.2f\}")\
        with col_b:\
            st.metric("\uc0\u55357 \u56518  Caruman Tahunan", f"RM \{result['annual']:,.2f\}")\
        \
        loading_text = "Tiada loading" if job_class != 4 else "Loading Class 4: +40%"\
        st.info(f"\uc0\u55357 \u56524  Umur \{age\} | \{gender\} | Job Class \{job_class\} (\{loading_text\})")\
    else:\
        st.error(f"\uc0\u10060  Data untuk umur \{age\} belum tersedia (20-55 sahaja).")}